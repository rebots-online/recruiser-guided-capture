#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Samples { uint values[]; } samples;
layout(set = 0, binding = 1, std430) writeonly buffer Points { float xyz[]; } points;
layout(push_constant) uniform Settings {
    uint width; uint height; uint minConfidence; uint padding;
    float fx; float fy; float cx; float cy;
} settings;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= settings.width * settings.height) return;
    uint packed = samples.values[i];
    uint mm = packed & 65535u;
    uint confidence = (packed >> 16) & 255u;
    float invalid = uintBitsToFloat(0x7fc00000u);
    vec3 p = vec3(invalid);
    if (mm >= 100u && mm <= 10000u && confidence >= settings.minConfidence) {
        float d = float(mm) * 0.001;
        p = vec3((float(i % settings.width) - settings.cx) * d / settings.fx,
                 -(float(i / settings.width) - settings.cy) * d / settings.fy, -d);
    }
    points.xyz[i * 3] = p.x;
    points.xyz[i * 3 + 1] = p.y;
    points.xyz[i * 3 + 2] = p.z;
}
